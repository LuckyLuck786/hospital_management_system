{
  "name": "medcore-hms",
  "version": "1.0.0",
  "description": "MedCore HMS - Hospital Management Platform",
  "private": true,
  "scripts": {
    "start": "pnpm --filter @medcore/backend db:deploy && pnpm --filter @medcore/backend start:prod",
    "build": "pnpm --filter @medcore/backend db:generate && pnpm --filter @medcore/backend build && pnpm --filter @medcore/frontend build",
    "dev": "pnpm -r dev",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter backend db:generate",
    "db:migrate": "pnpm --filter backend db:migrate",
    "db:seed": "pnpm --filter backend db:seed",
    "db:studio": "pnpm --filter backend db:studio",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}