{
  "$schema": "https://schema.railpack.com",
  "steps": {
    "install": {
      "commands": [
        "corepack enable",
        "pnpm install --frozen-lockfile",
        "pnpm --filter backend db:generate",
        "pnpm --filter backend build"
      ]
    }
  },
  "deploy": {
    "startCommand": "pnpm --filter backend db:deploy && cd apps/backend && node dist/src/main"
  }
}
