# Database
DATABASE_URL=postgresql://medcore:medcore_password@localhost:5432/medcore_hms?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-super-secret-jwt-key-minimum-256-bits-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Server
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# Email (Resend)
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM=noreply@medcore.hms

# SMS (Twilio)
TWILIO_ACCOUNT_SID=ACxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxx
TWILIO_PHONE_NUMBER=+1234567890

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxx

# Razorpay webhook secret (Phase 5) — Settings -> Webhooks -> create endpoint https://<host>/api/payments/webhook/razorpay
# and enable payment.captured / payment.failed events
RAZORPAY_WEBHOOK_SECRET=whsec_xxxxxxxx

# Realtime socket origin for the frontend in production (dev defaults to localhost:3001)
# NEXT_PUBLIC_SOCKET_URL=https://your-domain.com

# Integration-test database (jest e2e) — created automatically by global-setup
TEST_DATABASE_NAME=medcore_hms_test
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/medcore_hms_test?schema=public
